          "id": "first-10-minutes",
          "level": "optional"
        },
        {
          "heading": "Configuration",
          "id": "configuration",
          "level": "optional"
        },
        {
          "heading": "Usage",
          "id": "usage",
          "level": "required"
        },
        {
          "heading": "Repo Structure",
          "id": "repo-structure",
          "level": "optional"
        },
